# Projektname (Container: <PROJECT>-dev, Netz: <PROJECT>_net). Ordner-Konvention: cms.<kunde>
PROJECT=cms
# Hostname im lokalen Proxy (nginx-proxy), ohne Präfix: <kunde>.test
DEV_HOST=cms.test

# Öffentliche Basis-URL — muss mit den bei OAuth-Providern registrierten
# Redirect-URIs übereinstimmen (Redirect-URI = ORIGIN + /api/auth/callback/<provider>).
ORIGIN=http://localhost:5173
CMS_PORT=5173

# Geheimnis für Sessions/Tokens von Better Auth (mind. 32 Zeichen, z. B. `openssl rand -base64 32`)
AUTH_SECRET=change-me-please-change-me-please-change-me

# Datenbank (Index, Auth, Medien-Metadaten). Default: SQLite unter DATA_DIR.
#   sqlite:cms.db              → DATA_DIR/cms.db
#   postgres://user:pw@host/db → PostgreSQL
DATABASE_URL=sqlite:cms.db

# Verzeichnisse (im Container)
DATA_DIR=/app/data
STORAGE_DIR=/app/storage

# Der erste Nutzer registriert sich immer selbst und wird Admin. Danach legt ein Admin
# weitere Konten an; ALLOW_SIGNUP=1 nur bewusst für offene Registrierung setzen.
ALLOW_SIGNUP=0
# Zwei-Faktor-Anmeldung für Passwort-Konten (Authenticator-App + Backup-Codes):
# off = aus, optional = jeder Nutzer entscheidet unter „Sicherheit“, required = Pflicht
TWO_FACTOR=off
# Zusätzliche vertrauenswürdige Origins für Login/OAuth (Komma-getrennt, z. B. Alias-Domains)
TRUSTED_ORIGINS=

# OAuth-Provider (leer = deaktiviert)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Optionaler Bootstrap-Token mit Rolle admin (z. B. für den Seed). Für den Betrieb API-Zugänge im Admin anlegen.
API_TOKEN=

# Maximale Upload-Größe je Datei in MB
MAX_UPLOAD_MB=200

# SSH-Identität für das private Paket @compdata/ui (GitHub). Standard: ./.dev-ssh
DEV_SSH_DIR=./.dev-ssh

# Mail-Versand: file (Default, Ablage unter storage/mail/outbox) | smtp | microsoft | google
MAIL_TRANSPORT=file
MAIL_FROM="Website <noreply@example.com>"
# Standard-Empfänger, wenn eine Vorlage kein `to` setzt (kommagetrennt)
MAIL_TO_DEFAULT=
# smtp:  smtp://user:pass@mail.example.com:587  |  smtps://user:pass@mail.example.com:465
SMTP_URL=
# microsoft: App-Registrierung mit Anwendungsberechtigung Mail.Send; Sender = Postfach (UPN)
MS_MAIL_TENANT_ID=
MS_MAIL_CLIENT_ID=
MS_MAIL_CLIENT_SECRET=
MS_MAIL_SENDER=
# google: Service-Account-JSON (Pfad) mit domänenweiter Delegation, Sender = Workspace-Postfach
GOOGLE_MAIL_SERVICE_ACCOUNT=
GOOGLE_MAIL_SENDER=
# Formular-Sendungen pro Minute je IP auf /api/mail
RATE_LIMIT_MAIL_PER_MINUTE=5
# Aufbewahrung hochgeladener Formulardateien (storage/mail/uploads) in Tagen; 0 = unbegrenzt
MAIL_UPLOAD_RETENTION_DAYS=180
# Node-Server (adapter-node): Obergrenze für Request-Bodies — bei Formularen mit Uploads
# mindestens maxTotalSize der Vorlage plus etwas Reserve
BODY_SIZE_LIMIT=36M

# Captcha (ALTCHA, selbst gehostet, keine Drittanbieter). 0 schaltet es nur für Tests ab.
CAPTCHA=1
# Rechenaufwand der Aufgabe (PBKDF2-Iterationen); Geheimnis ist standardmäßig AUTH_SECRET
ALTCHA_COST=1000
CAPTCHA_SECRET=
RATE_LIMIT_CAPTCHA_PER_MINUTE=60

# Besucherstatistik (ohne Cookies, ohne IP-Speicherung). 0 schaltet die Erfassung ab.
ANALYTICS=1
# Aufbewahrung der Rohdaten in Tagen; Tage und Stunden zählen in dieser Zeitzone
ANALYTICS_RETENTION_DAYS=395
ANALYTICS_TIMEZONE=Europe/Berlin
# Messsignale pro Minute je IP auf /api/analytics
RATE_LIMIT_ANALYTICS_PER_MINUTE=120

# Nur Staging: 1 zeigt Fehlermeldung und Stacktrace auf der 500-Seite im Browser. Nie live setzen.
DEBUG_ERRORS=0
