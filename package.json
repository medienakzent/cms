{
	"name": "@medienakzent/cms",
	"version": "0.3.0",
	"description": "Block-basiertes CMS für SvelteKit: Übersetzung pro Feld, Versionierung, Storage als Wahrheit, Formulare mit Mail-Versand — Kundenprojekte erweitern nur um eigene Dateien.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/medienakzent/cms.git"
	},
	"type": "module",
	"bin": {
		"cms": "./bin/cms.js"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"bin",
		"templates",
		"admin.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"default": "./dist/server/index.js"
		},
		"./render": {
			"types": "./dist/render/index.d.ts",
			"svelte": "./dist/render/index.js",
			"default": "./dist/render/index.js"
		},
		"./admin": {
			"types": "./dist/admin/index.d.ts",
			"svelte": "./dist/admin/index.js",
			"default": "./dist/admin/index.js"
		},
		"./forms": {
			"types": "./dist/forms/index.d.ts",
			"svelte": "./dist/forms/index.js",
			"default": "./dist/forms/index.js"
		},
		"./routes/*": {
			"types": "./dist/routes/*.d.ts",
			"default": "./dist/routes/*.js"
		},
		"./pages/*": {
			"types": "./dist/pages/*.d.ts",
			"svelte": "./dist/pages/*",
			"default": "./dist/pages/*"
		},
		"./admin.css": "./admin.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "vite dev --host 0.0.0.0 --port 5173",
		"build": "vite build",
		"preview": "vite preview --host 0.0.0.0 --port 5173",
		"prepare": "svelte-kit sync && svelte-package",
		"postinstall": "node bin/cms.js postinstall",
		"package": "svelte-kit sync && svelte-package && publint",
		"sync": "node bin/cms.js sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest --run",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"peerDependencies": {
		"@compdata/ui": "*",
		"@lucide/svelte": "^0.561.0",
		"@sveltejs/kit": "^2.49.0",
		"bits-ui": "^2.14.0",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"svelte": "^5.45.0",
		"svelte-sonner": "^1.0.7",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.17",
		"tw-animate-css": "^1.4.0"
	},
	"dependencies": {
		"altcha": "^3.2.3",
		"altcha-lib": "^2.5.0",
		"better-auth": "^1.3.0",
		"better-sqlite3": "~12.8.0",
		"marked": "^16.0.0",
		"nanoid": "^5.1.0",
		"nodemailer": "^10.0.12",
		"pg": "^8.16.0",
		"sharp": "^0.34.0"
	},
	"devDependencies": {
		"@compdata/ui": "github:compdataitgmh/ui#v0.1.5",
		"@lucide/svelte": "^0.561.0",
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/package": "^2.3.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.15.0",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"publint": "^0.3.0",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"svelte-sonner": "^1.0.7",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.17",
		"tsx": "^4.20.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^7.2.6",
		"vitest": "^3.2.0"
	}
}
